<?php declare(strict_types=1);
/**
 * ROUTLAW local/prod secrets template — COMMITTED (no real values).
 *
 * Copy this file to `config/secrets.local.php` (gitignored, never commit the copy)
 * and fill in the values you control. Production uses the SAME keys via hPanel
 * env vars (or a prod-side copy outside git), exactly like mokimi.
 *
 * Conventions (mirrors mokimi):
 *  - Keys are UPPER_SNAKE RL_* so they cannot collide with PHP globals.
 *  - Empty string = service disabled / dev fallback (safe default).
 *  - Never commit real credentials. This file contains ONLY placeholders.
 */

// --- Database (least-privilege user in prod; see autoload prod guard) ---
$_ENV['RL_DB_HOST'] = '127.0.0.1';
$_ENV['RL_DB_USER'] = 'routlaw_app';        // TODO: prod least-privilege user
$_ENV['RL_DB_PASS'] = 'CHANGE_ME_DB_PASS';  // TODO: you supply
$_ENV['RL_DB_NAME'] = 'routlaw';
$_ENV['RL_DB_PORT'] = '3306';

// --- Outbound email: Apple iCloud SMTP via PHPMailer (STARTTLS, port 587) ---
// Use an iCloud app-specific password (16 chars), NOT the Apple ID password.
// Cloudflare sits in front of the domain; Apple SMTP sends through smtp.mail.me.com.
$_ENV['RL_SMTP_HOST']     = 'smtp.mail.me.com';
$_ENV['RL_SMTP_PORT']     = '587';
$_ENV['RL_SMTP_USERNAME'] = 'YOUR_ICLOUD_ADDR@icloud.com'; // TODO: you supply
$_ENV['RL_SMTP_PASSWORD'] = 'APP_SPECIFIC_PASSWORD';       // TODO: you supply
$_ENV['RL_SMTP_FROM']     = 'YOUR_ICLOUD_ADDR@icloud.com';
$_ENV['RL_SMTP_FROM_NAME'] = 'ROUTLAW';

// --- Cloudflare Turnstile (bot defense; preferred over reCAPTCHA behind CF) ---
// Get keys from Cloudflare Dashboard > Turnstile. Empty = verification skipped (dev).
// Front-end widget script: https://challenges.cloudflare.com/turnstile/v0/api.js
// Site key is safe to expose in HTML; secret key stays server-side only.
$_ENV['RL_TURNSTILE_SITE_KEY']  = 'CHANGE_ME_TURNSTILE_SITE_KEY';  // TODO: you supply
$_ENV['RL_TURNSTILE_SECRET_KEY'] = 'CHANGE_ME_TURNSTILE_SECRET';   // TODO: you supply
// RL_TURNSTILE_VERIFY_URL is a constant in autoload.php (no need to set here).

// --- Optional: runtime environment flag ---
// Set to 'prod' to enable the least-privilege DB guard and stricter error hiding.
