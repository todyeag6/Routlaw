# ROUTLAW — local dev environment template.
# Copy to `.env` (gitignored) and fill in. The real `.env` is NEVER committed
# and NEVER copied into the Docker image (see .dockerignore); compose injects
# it at runtime. Ref: https://docs.docker.com/build/building/secrets/
#
# For the Docker dev stack, RL_DB_HOST must be the compose service name (`db`).
RL_DB_HOST=db
RL_DB_USER=routlaw
RL_DB_PASS=change_me_dev_only
RL_DB_NAME=routlaw
RL_DB_PORT=3306
