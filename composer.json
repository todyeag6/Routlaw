{
  "name": "routlaw/routlaw",
  "description": "ROUTLAW Carrier Intelligence & Operations Platform (All-PHP 8.3, XAMPP/MariaDB).",
  "type": "project",
  "license": "Proprietary",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
